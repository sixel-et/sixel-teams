{
  "hooks": {
    "UserPromptSubmit": [
      {
        "command": "/path/to/sixel-teams/hooks/heartbeat.sh",
        "description": "Touch heartbeat file on each interaction"
      }
    ],
    "SessionStart": [
      {
        "command": "/path/to/sixel-teams/hooks/startup.sh",
        "description": "Start hub, write manifest, check peer messages"
      },
      {
        "matcher": "compact",
        "command": "/path/to/sixel-teams/hooks/post-compact.sh",
        "description": "Re-inject state after context compaction"
      }
    ]
  }
}
